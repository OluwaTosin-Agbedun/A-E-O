rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - allow read for site content, default deny write
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Reusable global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSubscriber(data) {
      return data.email is string 
          && data.email.size() <= 128 
          && data.channels is list 
          && data.subscribedAt is string;
    }

    // Subscribers collection matching
    match /subscribers/{subscriberId} {
      // Allow any visitor to subscribe
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      
      // Allow read and deletion only to signed-in admins
      allow read, delete: if isSignedIn();
    }

    // CMS documents collection matching (for site content, uploads, hero, stats, reports, logos, states)
    match /cms/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Publications and reports collections
    match /publications/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /reports/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Super Administrator Console collections
    match /cms_admins/{adminId} {
      // Allow read for admin verification
      allow read: if true;
      // Allow create, update, delete only to the permanent Super Administrator (Owner UID: BGknJG2kEwSVOxcQtNHeW6l0wUo1)
      allow write: if isSignedIn() && request.auth.uid == 'BGknJG2kEwSVOxcQtNHeW6l0wUo1';
    }

    match /cms_audit_logs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == 'BGknJG2kEwSVOxcQtNHeW6l0wUo1';
    }
  }
}

